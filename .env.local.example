# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ---------- MongoDB ----------
# MongoDB Atlas connection string. Create a free cluster at
# https://www.mongodb.com/cloud/atlas, add a database user, allow your
# IP (or 0.0.0.0/0 for serverless platforms like Vercel/Netlify), and
# copy the connection string here. Include a database name in the path,
# e.g. .../soulhues?retryWrites=true&w=majority
MONGODB_URI=

# ---------- Auth ----------
# Long random string used to sign admin session JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Admin login credentials. The password is stored as a bcrypt HASH, not
# plain text. Generate one with (after `npm install`):
#   npm run hash-password -- "your-chosen-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ---------- Cloudinary ----------
# From your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Razorpay (payments) ----------
# From your Razorpay dashboard: https://dashboard.razorpay.com/app/keys
# Use the Test Mode keys (prefixed rzp_test_...) while developing, and
# switch to Live Mode keys (rzp_live_...) only once you're ready to
# accept real payments. Same two values, just from the "Live" tab.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The client-side checkout widget needs the key ID too (NOT the secret —
# never expose RAZORPAY_KEY_SECRET with a NEXT_PUBLIC_ prefix). Set this
# to the exact same value as RAZORPAY_KEY_ID above.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Email (order confirmation / payment / shipping / delivery) ----------
# Works with any SMTP provider — Gmail (with an "app password", not your
# normal password), SendGrid, AWS SES, Mailgun, Postmark, etc. Example
# values below are for Gmail; check your provider's docs for theirs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Soul Hues
# If these are left blank, the app logs a warning and skips sending
# instead of crashing — orders still work, customers just won't get
# emails until this is configured.

# ---------- WhatsApp order notifications (optional) ----------
# By default, a new-order WhatsApp alert is generated as a tap-to-send
# link (no setup needed). For TRUE automatic sending with no manual tap,
# set these up via Meta's WhatsApp Business Cloud API — requires a
# verified WhatsApp Business Account:
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# Public site URL, used for metadata, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
